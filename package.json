{
  "name": "org-cockpit",
  "version": "1.0.0",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix frontend\" \"npm run electron\"",
    "electron": "cross-env NODE_ENV=DEV electron main/main.js",
    "build": "cd frontend && npm run build && cd .. && electron .",
    "build:frontend": "npm run build --prefix frontend",
    "dist": "npm run build:frontend && electron-builder"
  },
  "build": {
    "appId": "com.toby.orgcockpit",
    "productName": "Org Cockpit",
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "main/**/*",
      "frontend/dist/**/*",
      "package.json"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
